[application]

config/name="Car Prototype"
run/main_scene="res://Main.tscn"
config/icon="res://icon.png"

[autoload]

Logger="*res://addons/gs_logger/logger.gd"

[editor_plugins]

enabled=PoolStringArray( "res://addons/gs_logger/plugin.cfg" )

